# 所有文本文件在仓库里统一用 LF 换行
* text=auto eol=lf

# shell 脚本和 Docker 相关文件必须是 LF，否则在 Linux 上会报 $'\r': command not found
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.ico binary
